# Supabase Configuration
# Obtén estos valores desde tu dashboard de Supabase → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Login con Google / Facebook
# No requiere variables aquí: los Client ID / Secret se configuran en
# Supabase Dashboard → Authentication → Providers. Ver docs/OAUTH_SETUP.md

# Expo Push Notifications
# NOTA DE SEGURIDAD: El EXPO_ACCESS_TOKEN ya NO se incluye en la app cliente.
# Se configura de forma segura en la base de datos de Supabase:
# INSERT INTO public.server_secrets (key, value) VALUES ('EXPO_ACCESS_TOKEN', 'tu_token');
# Ver docs/migrations/01_push_triggers_pg_net.sql

# Google Maps API Key (Android standalone)
# Obtén una en https://console.cloud.google.com/ → APIs & Services → Credentials
# Habilita "Maps SDK for Android" y restringe la clave por app/package (SHA-1 fingerprint)
GOOGLE_MAPS_API_KEY=AIza...
