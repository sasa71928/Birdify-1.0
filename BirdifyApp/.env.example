# Supabase Configuration
# Obtén estos valores desde tu dashboard de Supabase → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Expo Push Notifications
# Crea un Access Token en https://expo.dev/accounts/[tu-cuenta]/settings/access-tokens
EXPO_PUBLIC_EXPO_ACCESS_TOKEN=abc123...

# Google Maps API Key (Android standalone)
# Obtén una en https://console.cloud.google.com/ → APIs & Services → Credentials
# Habilita "Maps SDK for Android" y restringe la clave por app/package
GOOGLE_MAPS_API_KEY=AIza...
